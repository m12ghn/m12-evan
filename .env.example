# Lấy tại Supabase → Project Settings → API. CHỈ dùng khóa anon/publishable, KHÔNG dùng service_role.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# --- Chỉ dùng ở máy chủ (Vercel), KHÔNG đặt tiền tố VITE_ và KHÔNG commit giá trị thật ---
# SUPABASE_SERVICE_ROLE_KEY=...
# TELEGRAM_BOT_TOKEN=123456:ABC...   (token bot; mã chat nhóm được cài trong app: Quản lý → Cài đặt → Thông báo Telegram)
